# Required public Supabase client configuration.
# The anon key is designed for browser use; never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional feature flag. The Anthropic API key remains server-side in Supabase secrets.
VITE_COPILOT_ENABLED=false

# Required public application metadata (embedded by Vite at build time).
# Do not leave these blank: the application refuses to start with deployment
# metadata hard-coded in the client.
VITE_PUBLIC_SITE_URL=
VITE_PUBLIC_APP_NAME=
VITE_PUBLIC_APP_TITLE=
VITE_PUBLIC_APP_DESCRIPTION=
VITE_PUBLIC_THEME_COLOR=
VITE_PUBLIC_OG_IMAGE_URL=

# Supabase Edge Function secrets/settings (configure with `supabase secrets set`,
# never expose these as VITE_* variables).
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=
# COPILOT_API_URL=
# COPILOT_ANTHROPIC_VERSION=
# COPILOT_MAX_TOKENS=
# COPILOT_MAX_QUESTION_CHARS=
# COPILOT_MAX_CONTEXT_CHARS=
# COPILOT_ALLOWED_ORIGIN=
# COPILOT_RATE_WINDOW_MS=
# COPILOT_RATE_MAX=
