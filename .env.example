# Required public Supabase client configuration.
# The anon key is designed for browser use; never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional feature flag. The Anthropic API key remains server-side in Supabase secrets.
VITE_COPILOT_ENABLED=false

# Optional public application metadata (embedded by Vite at build time).
VITE_PUBLIC_SITE_URL=https://metalflowpro.com
VITE_PUBLIC_APP_NAME=MetalFlow Pro
VITE_PUBLIC_APP_TITLE=
VITE_PUBLIC_APP_DESCRIPTION=
VITE_PUBLIC_THEME_COLOR="#0b0d10"
VITE_PUBLIC_OG_IMAGE_URL=
